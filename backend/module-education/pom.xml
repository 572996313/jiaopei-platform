<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cornerstone</groupId>
        <artifactId>jiaopei-platform-backend-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>module-education</artifactId>
    <name>module-education</name>
    <description>业务模块：教务（教师/学员/班级/课程/报名/排课/考勤/变动通知/小程序业务），依赖底座与教务主数据模块。</description>

    <!-- 教培专属业务模块，不属底座身份，不发私服（下游只消费 cornerstone-core）。 -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.cornerstone</groupId>
            <artifactId>cornerstone-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cornerstone</groupId>
            <artifactId>module-organization</artifactId>
        </dependency>
        <!-- 微信小程序登录是教培专属能力,SDK 只随本模块装配,底座不感知 -->
        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>wx-java-miniapp-spring-boot-starter</artifactId>
        </dependency>
        <!-- 账号批量导入要解析客户上传的 xlsx,只在业务侧用,底座不引(模板生成用其传递进来的 POI) -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
    </dependencies>
</project>
