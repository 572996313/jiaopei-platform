# frontend
frontend/node_modules/
frontend/dist/
# 测试运行产物（.last-run.json 一类），跑测试就会重建
frontend/test-results/

# backend（Maven 多模块：聚合工程与各子模块的构建产物）
backend/target/
backend/*/target/

# env
.idea/
.vscode/
*.iml

# logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# local config
.env
.env.*
/backend/.gitignore
# Copilot Java 升级扩展在 backend/ 下自动生成的 hooks（删了开 IDE 会重建）
/backend/.github/
/.tmp-edge-profile/**
/.tmp-chrome-schedule-walk/**
/.kilo/**

# docker prod secrets & runtime data
# docker-compose.prod.yml 是各服务器私有的运行实例（由 .example 复制生成），永远不进 git；
# 仓库只维护 docker/docker-compose.prod.yml.example 模板。
docker/prod.env
docker/docker-compose.prod.yml
docker/docker-compose.prod.yml.bak.*
# 预构建产物（CI 投递 / 本地构建），不进 git
docker/artifacts/
.deps-stamp
docker/data/
docker/backups/
docker/deploy.log
.claude/settings.local.json
/.claude/
/.zcode/
gui-test-screenshots/
/.zcode/
/data/
