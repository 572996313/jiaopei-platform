# Copy to docker/prod.env before starting the production trial stack.
# IMPORTANT: prod.env is .gitignored. Keep it on the host only.

DB_NAME=jiaopei_platform
DB_USERNAME=jiaopei
DB_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PORT=3306
# Set to 127.0.0.1 to bind only on localhost (debug-friendly), 0.0.0.0 for all interfaces.
MYSQL_BIND=0.0.0.0

REDIS_PORT=6379
# Set to 127.0.0.1 to bind only on localhost (debug-friendly), 0.0.0.0 for all interfaces.
REDIS_BIND=0.0.0.0
REDIS_DATABASE=0
REDIS_PASSWORD=

BACKEND_PORT=8080
BACKEND_BUILD_MAVEN_OPTS=-Xmx512m -XX:MaxMetaspaceSize=256m -Djava.awt.headless=true
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m

# JWT 签名密钥(必填,至少 32 字节的随机字符串,例如: openssl rand -base64 48)
AUTH_JWT_SECRET=please-generate-a-random-secret-at-least-32-bytes

FRONTEND_PORT=80

# 登录态由前端保存登录接口返回的 JWT 并自动携带,通常留空即可
VITE_API_AUTHORIZATION=
