# Copy to docker/prod.env before starting the production trial stack.

DB_NAME=jiaopei_platform
DB_USERNAME=jiaopei
DB_PASSWORD=123456
MYSQL_ROOT_PASSWORD=1234
MYSQL_PORT=3306

REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

BACKEND_PORT=8181
BACKEND_BUILD_MAVEN_OPTS=-Xmx512m -XX:MaxMetaspaceSize=256m -Djava.awt.headless=true
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m

FRONTEND_PORT=5757

# Current repository still uses stub authorization. Replace only after real auth is ready.
VITE_API_AUTHORIZATION=Bearer stub-access-token
