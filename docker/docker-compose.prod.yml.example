# ============================================================================
# 生产环境编排模板（总部维护）
#
# 本文件只是模板，不直接在服务器上运行。首次部署时复制为本地运行实例：
#     cp docker/docker-compose.prod.yml.example docker/docker-compose.prod.yml
# 然后按服务器实际情况修改 docker/docker-compose.prod.yml。
#
# docker/docker-compose.prod.yml 已写入 .gitignore，是各服务器私有的运行配置，
# git pull / deploy.sh 永远不会覆盖它；总部更新本模板后，手动对比合并：
#     diff -u docker/docker-compose.prod.yml.example docker/docker-compose.prod.yml
#
# 需要按环境调整的常见项（改本地实例，不要改本模板）：
#   - 复用宿主机/面板上已有的 MySQL、Redis（如 1Panel）：删除 mysql、redis 两个
#     服务块，删除 backend.depends_on 中的 mysql/redis，并把 backend 的
#     DB_HOST / DB_AUDIT_HOST / REDIS_HOST 指向真实中间件地址。
#     若中间件与 backend 同在一个外部网络，按《生产部署排障手册》场景 D 配置 networks；
#     若中间件监听宿主机端口，可用 host.docker.internal（需附 extra_hosts:
#     ["host.docker.internal:host-gateway"]）或宿主机桥接网卡地址。
#   - 端口（均指宿主机端口，容器内端口固定不变，在 docker/prod.env 中配置）：
#     MYSQL_PORT / REDIS_PORT / FRONTEND_PORT（默认 5757）/
#     BACKEND_PORT（默认 18090，仅绑定 127.0.0.1 供本机调试）。
#   - 数据目录：MYSQL_DATA_DIR / REDIS_DATA_DIR / MINIO_DATA_DIR（在 docker/prod.env 中配置）。
#   - 文件对象存储：默认跟随栈启动 MinIO。若复用外部 MinIO/S3 兼容服务，删除本文件的
#     minio 服务与 backend.depends_on.minio，并在 docker/prod.env 里把 MINIO_ENDPOINT
#     指向外部地址（后端只从容器内访问它，不需要对浏览器可达）。
#   - 容器名可以按服务器习惯修改：deploy.sh 的健康检查按 compose 服务名判断，
#     数据库备份也按服务名 mysql 定位实际容器，不再依赖 jiaopei-prod-* 这类固定名字。
#
# 自检：
#     docker compose -f docker/docker-compose.prod.yml --env-file docker/prod.env config
# ============================================================================
services:
  mysql:
    image: mysql:8.4
    container_name: jiaopei-prod-mysql
    restart: unless-stopped
    env_file:
      - prod.env
    environment:
      MYSQL_DATABASE: ${DB_NAME:-jiaopei_platform}
      MYSQL_USER: ${DB_USERNAME:-jiaopei}
      MYSQL_PASSWORD: ${DB_PASSWORD:-jiaopei_change_me}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-jiaopei_root_change_me}
      MYSQL_CHARACTER_SET_SERVER: utf8mb4
      MYSQL_COLLATION_SERVER: utf8mb4_unicode_ci
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      # MySQL 8.4 已移除 --default-authentication-plugin(8.0 deprecated / 8.4 移除),
      # 改用 authentication_policy。这里保持 caching_sha2_password(8.4 默认即此值,显式写明更可读)。
      - --authentication_policy=caching_sha2_password,,
      # - --authentication_policy=caching_sha2_password
    ports:
      - "${MYSQL_BIND:-0.0.0.0}:${MYSQL_PORT:-3306}:3306"
    volumes:
      - ${MYSQL_DATA_DIR:-/mnt/software/jiaopei/data/mysql}:/var/lib/mysql
      # 挂载建库脚本:创建操作留痕日志独立库 jiaopei_log(镜像 MYSQL_DATABASE 只能建一个库)
      - ./mysql-init:/docker-entrypoint-initdb.d
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p${MYSQL_ROOT_PASSWORD} --silent"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s

  redis:
    image: redis:7.4-alpine
    container_name: jiaopei-prod-redis
    restart: unless-stopped
    command: redis-server --appendonly yes
    ports:
      - "${REDIS_BIND:-0.0.0.0}:${REDIS_PORT:-6379}:6379"
    volumes:
      - ${REDIS_DATA_DIR:-/mnt/software/jiaopei/data/redis}:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10

  # 对象存储（文件管理的后端存储）。
  # 只绑 127.0.0.1：浏览器不直连 MinIO，上传/下载都经 backend 中转；控制台需要时再临时放开。
  minio:
    image: minio/minio:RELEASE.2025-04-22T22-12-26Z
    container_name: jiaopei-prod-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    env_file:
      - prod.env
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?请在 prod.env 中配置 MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?请在 prod.env 中配置 MINIO_ROOT_PASSWORD}
    ports:
      - "${MINIO_BIND:-127.0.0.1}:${MINIO_API_PORT:-9000}:9000"
      - "${MINIO_BIND:-127.0.0.1}:${MINIO_CONSOLE_PORT:-9001}:9001"
    volumes:
      - ${MINIO_DATA_DIR:-/mnt/software/jiaopei/data/minio}:/data
    healthcheck:
      # mc 是镜像自带的管理客户端；万一该 RELEASE 不带 mc，再退回健康检查端点
      test: ["CMD-SHELL", "mc ready local || curl -fsS http://127.0.0.1:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  # 依赖基础镜像(构建用，不启动容器)
  # 只有 pom.xml / 依赖声明变化时才重建，日常部署直接复用，避免重复下载依赖。
  # 日常不需要手动构建：deploy.sh 会按哈希自动判断。
  # 手动重建：docker compose -f docker/docker-compose.prod.yml --profile deps build backend-deps
  backend-deps:
    profiles: ["deps"]
    build:
      context: ..
      dockerfile: backend/Dockerfile.deps
    image: jiaopei-platform-backend-deps:prod

  # 前端依赖基础镜像(构建用，不启动容器)
  # 手动重建：docker compose -f docker/docker-compose.prod.yml --profile deps build frontend-deps
  frontend-deps:
    profiles: ["deps"]
    build:
      context: ..
      dockerfile: frontend/Dockerfile.deps
    image: jiaopei-platform-frontend-deps:prod

  backend:
    build:
      context: ..
      dockerfile: backend/Dockerfile
      args:
        DEPS_IMAGE: jiaopei-platform-backend-deps:prod
        MAVEN_OPTS: ${BACKEND_BUILD_MAVEN_OPTS:--Xmx512m -XX:MaxMetaspaceSize=256m -Djava.awt.headless=true}
    image: jiaopei-platform-backend:prod
    container_name: jiaopei-prod-backend
    restart: unless-stopped
    env_file:
      - prod.env
    environment:
      SERVER_PORT: 8080
      DB_HOST: mysql
      DB_PORT: 3306
      DB_NAME: ${DB_NAME:-jiaopei_platform}
      DB_USERNAME: ${DB_USERNAME:-jiaopei}
      DB_PASSWORD: ${DB_PASSWORD:-jiaopei_change_me}
      # 操作留痕日志库:同实例独立库,默认复用业务库连接;有独立账号时用 DB_AUDIT_* 覆盖
      DB_AUDIT_HOST: mysql
      DB_AUDIT_PORT: 3306
      DB_AUDIT_NAME: ${DB_AUDIT_NAME:-jiaopei_log}
      DB_AUDIT_USERNAME: ${DB_AUDIT_USERNAME:-jiaopei}
      DB_AUDIT_PASSWORD: ${DB_AUDIT_PASSWORD:-${DB_PASSWORD:-jiaopei_change_me}}
      # 敏感数据加解密密钥(必填,生产必须配置强随机串,至少 16 字节)
      DATA_ENCRYPT_KEY: ${DATA_ENCRYPT_KEY:-${AUTH_JWT_SECRET}}
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_DATABASE: ${REDIS_DATABASE:-0}
      REDIS_PASSWORD: ${REDIS_PASSWORD:-}
      AUTH_JWT_SECRET: ${AUTH_JWT_SECRET:?请在 prod.env 中配置 AUTH_JWT_SECRET(至少 32 字节的随机字符串)}
      # 微信小程序(教培学堂)登录用;未配置时后端可正常启动,仅微信登录接口返回明确提示
      WECHAT_MINIAPP_APPID: ${WECHAT_MINIAPP_APPID:-}
      WECHAT_MINIAPP_SECRET: ${WECHAT_MINIAPP_SECRET:-}
      # 文件存储：默认连本编排内的 minio 服务；桶由后端启动时自动创建。
      # 复用外部 MinIO 时不用改本文件，在 prod.env 里覆盖 MINIO_ENDPOINT 即可
      # （填容器名 http://<minio容器名>:9000，或宿主机映射端口 http://host.docker.internal:9000）。
      FILE_STORAGE_PROVIDER: ${FILE_STORAGE_PROVIDER:-minio}
      MINIO_ENDPOINT: ${MINIO_ENDPOINT:-http://minio:9000}
      MINIO_BUCKET: ${MINIO_BUCKET:-jiaopei-files}
      # 应用侧凭据在 prod.env 显式写，不用嵌套展开（不同 compose 版本支持程度不一）
      MINIO_ACCESS_KEY: ${MINIO_ACCESS_KEY}
      MINIO_SECRET_KEY: ${MINIO_SECRET_KEY}
      MINIO_REGION: ${MINIO_REGION:-us-east-1}
      JAVA_TOOL_OPTIONS: ${BACKEND_JAVA_OPTS:-}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_healthy
    expose:
      # 容器内端口固定 8080，在 Docker 网络内不占用宿主机端口；业务请求统一走前端 Nginx 的 /api 反代。
      - "8080"
    ports:
      # 宿主机调试口：18090 → 容器 8080。默认只绑 127.0.0.1，不对外暴露；
      # 需要局域网/公网直连时把 BACKEND_BIND 改成 0.0.0.0（不建议，生产入口应统一走前端 Nginx）。
      - "${BACKEND_BIND:-127.0.0.1}:${BACKEND_PORT:-18090}:8080"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/api/health >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 90s

  frontend:
    build:
      context: ..
      dockerfile: frontend/Dockerfile
      args:
        DEPS_IMAGE: jiaopei-platform-frontend-deps:prod
    image: jiaopei-platform-frontend:prod
    container_name: jiaopei-prod-frontend
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_healthy
    ports:
      # 宿主机 5757 → 容器 nginx 80。容器内仍是 80，不占用宿主机 80/443（常被面板或其它站点占用）。
      - "${FRONTEND_PORT:-5757}:80"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
